APP_NAME="Asistente Académico"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Sin base de datos: la web no guarda nada (la memoria de las conversaciones y los datos académicos viven en n8n Cloud y Supabase)
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Chat: URL de producción del webhook del chat en n8n Cloud (nodo "Chat" > Production URL) y su usuario y clave (credencial "Chat web (Laravel)")
N8N_CHAT_URL=https://TU-INSTANCIA.app.n8n.cloud/webhook/ID-DEL-WEBHOOK/chat
N8N_CHAT_USER=
N8N_CHAT_PASSWORD=
