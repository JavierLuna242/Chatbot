{
  "id": "unabIngesta00001",
  "name": "Ingesta de documentos (RAG)",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "1c1d6c1e-0001-4c55-9a11-000000000001",
      "name": "Subir documento",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.3,
      "position": [
        0,
        300
      ],
      "webhookId": "b5e7d2e3-6c2f-4c8b-8d66-1b2c3d4e5f60",
      "parameters": {
        "formTitle": "Ingesta de documentos institucionales",
        "formDescription": "Sube PDF, DOCX, TXT o MD del programa / CCD para que el chatbot los use como base de conocimiento.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Documento",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".pdf,.docx,.txt,.md",
              "requiredField": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1c1d6c1e-0002-4c55-9a11-000000000002",
      "name": "Guardar en PGVector",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [
        260,
        300
      ],
      "parameters": {
        "mode": "insert",
        "tableName": "n8n_vectors",
        "embeddingBatchSize": 100,
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "pgSupabase0000001",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "id": "1c1d6c1e-0003-4c55-9a11-000000000003",
      "name": "Cargar documento",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        360,
        520
      ],
      "parameters": {
        "dataType": "binary",
        "binaryMode": "allInputData",
        "loader": "auto",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "documento",
                "value": "={{ $json.fileName.replace(/\\.[^.]+$/, '').replace(/_/g, ' ') }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "1c1d6c1e-0004-4c55-9a11-000000000004",
      "name": "Fragmentar (chunking)",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        460,
        720
      ],
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 150,
        "options": {}
      }
    },
    {
      "id": "1c1d6c1e-0005-4c55-9a11-000000000005",
      "name": "Embeddings Gemini",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        160,
        520
      ],
      "parameters": {
        "modelName": "models/gemini-embedding-001"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "geminiUnab0000001",
          "name": "Gemini"
        }
      }
    },
    {
      "name": "Separar archivos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Un ítem por archivo: así cada fragmento guarda de qué documento viene (metadato \"documento\").\nconst salida = [];\nfor (const item of $input.all()) {\n  for (const b of Object.values(item.binary || {})) {\n    salida.push({ json: { fileName: b.fileName }, binary: { data: b } });\n  }\n}\nreturn salida;"
      },
      "position": [
        760,
        300
      ],
      "id": "0b0d6c1e-0012-4c55-9a11-000000000020"
    }
  ],
  "connections": {
    "Subir documento": {
      "main": [
        [
          {
            "node": "Separar archivos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cargar documento": {
      "ai_document": [
        [
          {
            "node": "Guardar en PGVector",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Fragmentar (chunking)": {
      "ai_textSplitter": [
        [
          {
            "node": "Cargar documento",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings Gemini": {
      "ai_embedding": [
        [
          {
            "node": "Guardar en PGVector",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Separar archivos": {
      "main": [
        [
          {
            "node": "Guardar en PGVector",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}