# Copiar a .env y completar (nunca subir .env a git). Lo lee instalacion-debian/instalar_debian.sh en la VM de Azure.
# Las claves de Groq y Gemini y la conexión a Supabase de n8n NO van aquí: se crean como credenciales dentro de n8n Cloud.

# Supabase > Connect > Session pooler (IPv4). Contraseña de la base: Project Settings > Database.
DATABASE_URL=postgresql://postgres.REF_DEL_PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
# Token del servidor MCP (mínimo 32 caracteres): openssl rand -hex 32. El mismo valor va en la credencial "MCP UNAB (token)" de n8n.
MCP_TOKEN=
# Web -> n8n Cloud: Production URL del nodo Chat y usuario/clave de la credencial "Chat web (Laravel)"
N8N_CHAT_URL=https://TU-INSTANCIA.app.n8n.cloud/webhook/ID-DEL-WEBHOOK/chat
N8N_CHAT_USER=
N8N_CHAT_PASSWORD=
# Opcional: Google Sheet del calendario publicado como CSV (Archivo > Compartir > Publicar en la web > CSV)
# Columnas: evento,fecha_inicio,fecha_fin,categoria
CALENDARIO_CSV_URL=
